generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  password         String
  level            String    @default("B1")
  reputation       Int       @default(100)
  birthDate        String?
  showAgeInProfile Boolean   @default(true)
  gender           String?
  pronouns         String?
  bio              String?
  interests        String[]
  avatar           String?
  notifyEmail      Boolean   @default(true)
  notifyPush       Boolean   @default(true)
  notifyAdvance    String    @default("15")
  streak           Int       @default(0)
  totalMinutes     Int       @default(0)
  totalSessions    Int       @default(0)
  lastSession      Json?
  sessionsHistory  Json[]
  minutesHistory   Json[]
  weeklyGoal       Json?
  reportCount      Int       @default(0)
  flagStatus       String    @default("clean")
  flagReason       String?
  flaggedAt        DateTime?
  isBanned         Boolean   @default(false)
  bannedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Report {
  id               String    @id @default(uuid())
  reporterId       String
  reportedUserId   String
  reason           String
  description      String?
  status           String    @default("open")
  resolvedAt       DateTime?
  resolution       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}