generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  password     String
  level        String   @default("B1")
  reputation   Int      @default(98)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}