generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password      String
  tag           String   @unique @default("User#0000")
  level         String   @default("B1")
  reputation    Int      @default(100)
  birthDate       String?
  showAgeInProfile Boolean       @default(true)
  gender          String?
  pronouns        String?
  bio             String?
  interests       String[]
  avatar          String?
  notifyEmail     Boolean        @default(true)
  notifyPush      Boolean        @default(true)
  notifyAdvance   String         @default("15")
  streak          Int            @default(0)
  totalMinutes    Int            @default(0)
  totalSessions   Int            @default(0)
  lastSession     Json?
  sessionsHistory Json[]
  minutesHistory  Json[]
  weeklyGoal      Json?
  reportCount     Int            @default(0)
  flagStatus      String         @default("clean")
  flagReason      String?
  flaggedAt       DateTime?
  isBanned        Boolean        @default(false)
  bannedUntil     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  
  notifications       Notification[]
  sentFriendships     FriendRelation[] @relation("UserFriendships")
  receivedFriendships FriendRelation[] @relation("FriendOfUser")
  
  sentMessages        DirectMessage[]  @relation("SentMessages")
  receivedMessages    DirectMessage[]  @relation("ReceivedMessages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id              String    @id @default(uuid())
  reporterId      String
  reportedUserId  String
  reason          String
  description     String?
  status          String    @default("open")
  resolvedAt      DateTime?
  resolution      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model FriendRelation {
  id        String   @id @default(uuid())
  userId    String
  friendId  String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user   User @relation("UserFriendships", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendOfUser", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
}

model DirectMessage {
  id          String   @id @default(uuid())
  senderId    String
  recipientId String
  text        String
  createdAt   DateTime @default(now())

  sender    User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
} 